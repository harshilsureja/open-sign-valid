{
  "name": "open-sign-valid",
  "description": "Verify Aadhaar and other digitally signed PDFs privately in your browser",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "homepage": "https://github.com/harshil-at/open-sign-valid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshil-at/open-sign-valid.git"
  },
  "bugs": {
    "url": "https://github.com/harshil-at/open-sign-valid/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "samples": "node scripts/make-samples.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "asn1js": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "pkijs": "^3.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.39",
    "@types/node": "^22",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.0.5"
  }
